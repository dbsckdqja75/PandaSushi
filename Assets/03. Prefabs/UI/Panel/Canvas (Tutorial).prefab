  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uAC11\uC791\uC2A4\uB7FD\uAC8C \uBD88\uB7EC \uBBF8\uC548\uD558\uAD6C\uB098.\n\uD560\uC544\uBC84\uC9C0\uAC00
    \uC5C6\uC5B4\uC11C \uB2F9\uD669\uD588\uACA0\uC9C0\uB9CC \uAE09\uD788 \uBD80\uD0C1\uD560\uAC8C
    \uC788\uB2E8\uB2E4..\n\n\uB3D9\uCABD \uBA3C \uACF3\uC758 \uC5B4\uB290 \uC5BC\uC74C
    \uC0B0\uB9E5 \uC18D\uC5D0\n\uC804\uC124\uC758 \uCD08\uBC25 \uB808\uC2DC\uD53C\uAC00
    \uC228\uACA8\uC838 \uC788\uB2E4\uACE0 \uD558\uC5EC\n\uC9C1\uC811 \uCC3E\uC73C\uB7EC
    \uAC08 \uC0DD\uAC01\uC774\uC5C8\uB294\uB370, \uADF8\uB7FC \uB2F9\uBD84\uAC04
    \uD560\uC544\uBC84\uC9C0\uAC00 \uAC00\uAC8C\uB97C \uBCFC \uC218 \uC5C6\uACA0\uB354\uAD6C\uB098.\n\n\uADF8\uB798\uC11C
    \uD55C\uB3D9\uC548 \uAC00\uAC8C\uB97C \uBD10\uC8FC\uBA74 \uC88B\uACA0\uAD6C\uB098.\n<color=#787878><size=28><s>(\uC808\uB300\uB85C
    \uC740\uADFC\uC2AC\uCA4D \uBB3C\uB824\uC8FC\uB824\uACE0 \uD558\uB294 \uAC83 \uC544\uB2D8.
    \uC808\uB300\uB85C.. \uC544\uB9C8\uB3C4?)</s></size></color>\n\uAE4C\uB2E4\uB85C\uC6B4
    \uC190\uB2D8\uB4E4\uB3C4 \uCC3E\uC544\uC624\uB294 \uAC00\uAC8C\uB77C \uC27D\uC9C4
    \uC54A\uACA0\uC9C0\uB9CC\n\uB0A8\uACA8\uB193\uC740 \uB9CC\uB2A5 \uB808\uC2DC\uD53C\uBD81\uC774
    \uC788\uC73C\uB2C8 \uB2A5\uB825 \uC88B\uC740 \uC6B0\uB9AC \uC190\uC8FC\uB77C\uBA74
    \uD574\uB0BC \uC218 \uC788\uC744 \uAC70\uB77C \uBBFF\uB294\uB2E8\uB2E4.\n\uC774\uC81C
    \uC2DC\uAC04\uC774 \uB41C \uAC83 \uAC19\uC73C\uB2C8 \uB098\uC911\uC5D0 \uBCF4\uC790\uAFB8\uB098.\n\n\n<i>\uCD94\uC2E0.</i>\n\uBC30\uB2EC
    \uC8FC\uBB38\uB3C4 \uC788\uACE0 \uB9AC\uBDF0 \uD3C9\uC810 \uAD00\uB9AC\uB3C4
    \uD574\uC57C \uD558\uB2C8 \uC2E0\uACBD \uC368\uC8FC\uBA74 \uC88B\uACA0\uAD6C\uB098.
    \uD798\uB0B4\uB834! <sprite=0>"
